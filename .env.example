# Synchronisation Google Sheets (voir README > Synchronisation Google Sheets)
# Lien de la feuille, pour référence : la synchronisation passe par PSYCHO_SHEETS_SYNC_URL
PSYCHO_SHEETS_URL=
# URL du Web App Google Apps Script, ex. https://script.google.com/macros/s/AKfy.../exec
PSYCHO_SHEETS_SYNC_URL=
# Valeur de la propriété SYNC_TOKEN définie dans le script
PSYCHO_SHEETS_SYNC_TOKEN=
# true = logs détaillés de la synchronisation (défaut: __DEV__)
# PSYCHO_SYNC_DEBUG=true
